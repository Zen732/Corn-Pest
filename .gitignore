app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Backend secrets and Python artifacts
.env
__pycache__/
.venv/
.ipynb_checkpoints/

